# Portainer stack environment variables (paste into Stack → Environment variables)

# Pre-built public images: https://hub.docker.com/r/derpmhichurp/scanhead
DOCKER_HUB_REGISTRY_USERNAME=derpmhichurp
DOCKER_HUB_IMAGE_NAME=scanhead
IMAGE_TAG=latest

# MediaMTX image tag (needs ffmpeg for the audio gate/compressor)
MEDIAMTX_TAG=1-ffmpeg

# Scanner on the same LAN as the Docker host (DHCP reservation recommended).
# UDP control can use a DNS name. Uniden RTSP OPTIONS returns 400 unless the
# URL host is a dotted-quad (the radio's own Wi-Fi/Ethernet address).
SCANNER_IP=192.168.42.10
SCANNER_RTSP_IP=192.168.42.10
SCANNER_PORT=50536

# LAN address of the Docker/Portainer host (required for WebRTC ICE).
# Use the hostname or IP you type in the browser, not a Docker bridge IP.
WEBRTC_HOST=192.168.42.5

# Published host ports (shown in Portainer / docker ps).
# MediaMTX publishes 8554 (RTSP), 8888 (listen-only MPEG-TS HLS of AAC `player`),
# 8889 (WebRTC/WHEP), 8189/udp (ICE) as fixed mappings.
APP_PORT=8080
PSI_INTERVAL_MS=500
MEDIAMTX_WHEP_PORT=8889
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_RTSP_PORT=8554

# Audio filter (MediaMTX ffmpeg). Lower AUDIO_GATE_THRESHOLD if speech is chopped;
# raise it if scan hiss comes through. Linear 0–1, not dB.
AUDIO_HIGHPASS_HZ=200
AUDIO_GATE_THRESHOLD=0.01
AUDIO_GATE_RATIO=10
AUDIO_GATE_ATTACK_MS=5
AUDIO_GATE_RELEASE_MS=150
AUDIO_GATE_RANGE=0.002
AUDIO_COMP_THRESHOLD=0.1
AUDIO_COMP_RATIO=6
AUDIO_COMP_ATTACK_MS=10
AUDIO_COMP_RELEASE_MS=200
AUDIO_COMP_MAKEUP=4
