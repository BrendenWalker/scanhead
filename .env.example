# Scanner on the same LAN as the Docker host (DHCP reservation recommended).
SCANNER_IP=192.168.42.10
# Required if SCANNER_IP is a hostname; Uniden RTSP 400s on DNS names.
# SCANNER_RTSP_IP=192.168.42.10

# Optional overrides
# SCANNER_PORT=50536
# APP_PORT=8080
# PSI_INTERVAL_MS=500
# MEDIAMTX_WHEP_PORT=8889
# MEDIAMTX_HLS_PORT=8888
# MEDIAMTX_RTSP_PORT=8554
# MEDIAMTX_TAG=1-ffmpeg

# Audio filter (MediaMTX ffmpeg highpass → noise gate → compressor).
# Values are interpolated into the ffmpeg command when the stack is created;
# recreate the mediamtx container after changing any of these.
# Thresholds and range are linear 0–1, not dB: 0.01 ≈ -40 dB, 0.03 ≈ -30 dB.
#
# High-pass cutoff in Hz. Removes rumble/hum below this. 200 Hz suits analog
# radio; raise if there is wind/hum, lower if voice sounds thin.
# AUDIO_HIGHPASS_HZ=200
#
# Gate open level (linear). Below this, scan hiss is muted. Lower if syllables
# get chopped; raise if hiss comes through between transmissions.
# AUDIO_GATE_THRESHOLD=0.01
#
# How hard the gate closes below threshold. Higher = more mute. 10 is a strong
# close; 1 is no gating.
# AUDIO_GATE_RATIO=10
#
# Milliseconds the signal must stay above the gate threshold before it opens.
# Lower opens faster on word starts (may click); higher can clip the first syllable.
# AUDIO_GATE_ATTACK_MS=5
#
# Milliseconds the signal must stay below the gate threshold before it closes.
# Raise (e.g. 250) to hold through short pauses in speech; lower if hiss leaks
# between words.
# AUDIO_GATE_RELEASE_MS=150
#
# Residual level while the gate is closed (linear). Small ≈ mute. 0.002 is about
# -54 dB. Do not set to 0 — ffmpeg then disables reduction.
# AUDIO_GATE_RANGE=0.002
#
# Compressor start level (linear). Above this, loud peaks are reduced. 0.1 ≈ -20 dB
# (peaks only); lower (e.g. 0.03 ≈ -30 dB) to even quiet analog vs loud P25.
# AUDIO_COMP_THRESHOLD=0.1
#
# Compression ratio above the compressor threshold. 6 means 6:1. Higher flattens
# loud talkgroups more.
# AUDIO_COMP_RATIO=6
#
# Milliseconds before gain reduction starts after crossing the compressor
# threshold. Fast (5–15) suits radio voice.
# AUDIO_COMP_ATTACK_MS=10
#
# Milliseconds after falling below the compressor threshold before gain
# reduction lets go. Too short pumps; too long ducks the next transmission.
# AUDIO_COMP_RELEASE_MS=200
#
# Linear makeup gain after compression (1 = none, 4 ≈ +12 dB). Raises the
# compressed speech. Too high clips or makes gated residual audible.
# AUDIO_COMP_MAKEUP=4

# Pull a published app image instead of (or after) building locally
# DOCKER_HUB_REGISTRY_USERNAME=derpmhichurp
# DOCKER_HUB_IMAGE_NAME=scanhead
# IMAGE_TAG=latest
